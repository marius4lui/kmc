{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marius4lui/kmc/blob/main/schema.json",
  "title": "kmc configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "default": []
    },
    "commands": {
      "description": "Legacy flat command list. kmc migrates this to groups automatically.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "anyOf": [
    {
      "required": ["groups"]
    },
    {
      "required": ["commands"]
    }
  ],
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "commands"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["manual", "imported", "skill"]
        },
        "source": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          },
          "default": []
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "groupId": {
          "description": "Legacy group identifier. Grouped configurations infer this from the parent group.",
          "type": "string"
        },
        "group": {
          "description": "Legacy alias for groupId.",
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "imported": {
          "type": "boolean"
        }
      }
    }
  }
}
